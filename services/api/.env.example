OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Speech-to-text for Query mode (OpenAI Whisper API)
OPENAI_WHISPER_MODEL=whisper-1
# Optional: GeoNames account for /geo/cities and /geo/timezone (birth place autocomplete)
# GEONAMES_USERNAME=demo
# Optional: only for local_json / tests; default is services/data next to this API package
# DATA_DIR=/path/to/custom/data

# Supabase (required for auth + cloud storage)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Production (Render / custom host): comma-separated browser origins allowed to call the API
# CORS_ORIGINS=https://astramap.app,https://www.astramap.app

# Verbose logs for POST /sessions/.../query/stream (system prompt, raw markdown, parse_query_markdown JSON)
# DEBUG_QUERY_PIPELINE=1
# Log full user JSON + full markdown (large)
# DEBUG_QUERY_PIPELINE_RAW_FULL=1
