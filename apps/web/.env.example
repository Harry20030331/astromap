# FastAPI base URL (no trailing slash — avoids //geo/... 404 when paths start with /)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to 1 to print API_URL in the browser console (troubleshoot fetch / CORS / LAN)
# NEXT_PUBLIC_DEBUG_API=1

# Supabase (required for auth)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Google Search Console site verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code_here
